# Copy to .env and fill the blank credentials before starting.
# STEAM_API_SECRET must match the PHP receiver secret.
# Preserve the existing ENCRYPTION_KEY for an existing database.
# POLL_INTERVAL_MS only controls legacy dashboard display; the worker uses webhooks.

# Server
NODE_ENV="development"
PORT="5000"
API_URL="http://localhost:5000"
FRONTEND_URL="http://localhost:5000"
WEBHOOK_URL="https://collector.example.com/api/webhooks/mail"

# Database and Redis (localhost refers to the machine running this app)
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/mail_collector"
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Dashboard authentication and stored-token encryption
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
ENCRYPTION_KEY=""
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Microsoft OAuth
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="https://collector.example.com/api/auth/microsoft/callback"
MICROSOFT_SCOPES="offline_access User.Read Mail.Read Mail.Send"

# Steam API delivery
STEAM_API_URL="https://example.com/api/steam_inbound.php"
STEAM_API_SECRET=""
STEAM_API_TIMEOUT_MS="5000"
STEAM_ONLY="true"
STEAM_ALLOWED_DOMAINS="steampowered.com"
STEAM_ALLOWED_SENDERS="noreply@steampowered.com"
FORWARD_DELAY_MS="150"

# SMTP notifications
DEV_EMAIL=""
FORWARD_TO_EMAIL="notifications@example.com"
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mail Collector <notifications@example.com>"

# Existing manual retry and dashboard display settings
MAX_RETRIES="5"
POLL_INTERVAL_MS="10000"

# Logging
LOG_LEVEL="info"
LOG_FILE="logs/app.log"
